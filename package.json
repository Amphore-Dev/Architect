{
	"name": "@amphore-dev/architect",
	"version": "2.0.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Amphore-Dev/Architect.git"
	},
	"author": "Amphore Dev <contact@amphore.dev>",
	"license": "MIT",
	"description": "A CLI tool to generate files and folders based on blueprints",
	"main": "dist/index.js",
	"types": "dist/declarations/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/declarations/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema.json": "./schema.json",
		"./package.json": "./package.json"
	},
	"bin": {
		"architect": "dist/cli.js"
	},
	"scripts": {
		"start": "node dist/cli.js",
		"build": "tsc -p tsconfig.build.json && yarn copy-blueprints",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"prettier": "prettier 'src/**/*.{ts,tsx,js,jsx,json}'",
		"prettier:fix": "prettier 'src/**/*.{ts,tsx,js,jsx,json}' --write",
		"copy-blueprints": "node -e \"require('fs').cpSync('src/blueprints','dist/blueprints',{recursive:true})\"",
		"test": "yarn build && vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@inquirer/confirm": "^6.3.4",
		"@inquirer/select": "^5.2.7",
		"commander": "^15.0.0",
		"esbuild": "^0.28.2",
		"node-color-log": "^14.0.0"
	},
	"devDependencies": {
		"@amphore-dev/architect-plugin-react": "^1.0.6",
		"@eslint/js": "^10.0.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"directories": {
		"example": "example"
	},
	"keywords": [
		"CLI",
		"blueprint",
		"file",
		"folder",
		"generator"
	],
	"bugs": {
		"url": "https://github.com/Amphore-Dev/Architect/issues"
	},
	"homepage": "https://github.com/Amphore-Dev/Architect#readme",
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"dist",
		"schema.json"
	]
}
