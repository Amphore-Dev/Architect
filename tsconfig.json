{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"target": "es2023",
		"module": "node20",
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationDir": "./dist/declarations",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "src/blueprints/**/*"]
}
